# ─────────────────────────────────────────────────────────────
# Codex Gateway — Phase 0
# Copy to .env and fill in. Never commit .env.
# ─────────────────────────────────────────────────────────────

# Runtime
NODE_ENV=development
PORT=3000
API_PREFIX=api

# Comma-separated list of allowed browser origins.
CORS_ORIGINS=http://localhost:3001

# ── App authentication (NOT Codex authentication) ────────────
# Signs the JWT issued to users of this gateway.
# Must be at least 32 characters. Generate one with:
#   node -e "console.log(require('crypto').randomBytes(48).toString('base64url'))"
JWT_SECRET=
JWT_EXPIRES_IN=1d

# Seed administrator. Only an admin may drive the Codex login flow,
# because Codex auth is global to this host and affects every user.
# Generate the hash with:  npm run auth:hash -- "your-password"
ADMIN_EMAIL=admin@example.com
ADMIN_PASSWORD_HASH=

# ── Codex runtime ────────────────────────────────────────────
# Optional. Leave empty to resolve the binary from node_modules,
# which pins Codex to the version in package.json.
CODEX_BIN=

# Where Codex keeps auth.json and sessions/. Leave empty for the default
# (~/.codex). This is machine-global state shared by every gateway user.
CODEX_HOME=

# ─────────────────────────────────────────────────────────────
# Windows note: do NOT create .env with PowerShell `Out-File -Encoding utf8`.
# On PowerShell 5.1 that writes a UTF-8 BOM, and the BOM becomes part of the
# first variable's name — the first line is then silently ignored. Use
# `Set-Content -Encoding utf8NoBOM`, or just edit this file in an editor.
# ─────────────────────────────────────────────────────────────
